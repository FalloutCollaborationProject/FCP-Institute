<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Enlistment with the Institute __________-->

    <FCP.Enlist.FactionEnlistOptionsDef>
        <defName>FCP_Enlistment_Institute</defName>
        <label>The Institute</label>
        <currencyDef>Silver</currencyDef>
        <minGoodwillRequrementToEnlist>10</minGoodwillRequrementToEnlist>
        <enlistGoodwillGain>5</enlistGoodwillGain>
        <minGoodwillUponEnlist>75</minGoodwillUponEnlist>

        <!-- Enlistment Options -->

        <enlistLetterTitleKey>FCP_Institute_Enlist_Letter_Title</enlistLetterTitleKey>
        <enlistLetterLabelKey>FCP_Institute_Enlist_Letter_Label</enlistLetterLabelKey>
        <enlistButtonLabelKey>FCP_Institute_Enlist_Button_Label</enlistButtonLabelKey>
        <enlistButtonDescKey>FCP_Institute_Enlist_Button_Desc</enlistButtonDescKey>
        <enlistRequrementsNotSatisfiedKey>FCP_Institute_Enlist_Requrements_Not_Satisfied</enlistRequrementsNotSatisfiedKey>
        <enlistedToHostileFactionKey>FCP_Institute_Enlisted_To_Hostile_Faction</enlistedToHostileFactionKey>
        <enlistButtonIconTexPath>UI/Memes/Loyalist</enlistButtonIconTexPath>
        <enlistedSoundDef>FCP_Sound_Card_Use</enlistedSoundDef>
        <enlistedWithKey>FCP_Institute_Enlisted_With_Key</enlistedWithKey>

        <!-- Mission Options -->

        <missionsAreEnabled>true</missionsAreEnabled>
        <missionsLabelKey>FCP_Institute_Missions_Label</missionsLabelKey>
        <missionsDescKey>FCP_Institute_Missions_Desc</missionsDescKey>
        <missionsButtonIconTexPath>UI/Abilities/CombatCommand</missionsButtonIconTexPath>
        <missionsBackgroundMenuTexPath>UI/Abilities/CombatCommand</missionsBackgroundMenuTexPath>
        <missionsMenuDescriptionKey>FCP_Institute_Menu_Missions_Desc</missionsMenuDescriptionKey>
        <missionsMenuSelectQuestKey>FCP_Institute_Menu_Missions_Select_Quest</missionsMenuSelectQuestKey>
        <missionsMenuStartQuestKey>FCP_Institute_Menu_Missions_Start_Quest</missionsMenuStartQuestKey>
        <missionsBountyRewardRange>40~100</missionsBountyRewardRange>
        <missionsMenuCollectBountyKey>FCP_Institute_Menu_Missions_Collect_Bounty</missionsMenuCollectBountyKey>

        <!-- Salary Options -->

        <salaryIsEnabled>true</salaryIsEnabled>
        <salaryDef>Silver</salaryDef>
        <salaryLabelKey>FCP_Institute_Salary_Label</salaryLabelKey>
        <salaryDescKey>FCP_Institute_Salary_Desc</salaryDescKey>
        <salaryRange>15000~28000</salaryRange>
        <salaryPeriodDays>14</salaryPeriodDays>

        <!-- Storage Options -->

        <storageIsEnabled>true</storageIsEnabled>
        <storageLabelKey>FCP_Institute_Storage_Label</storageLabelKey>
        <storageDescKey>FCP_Institute_Storage_Desc</storageDescKey>
        <storageButtonIconTexPath>UI/Icons/ThingCategories/ResourcesRaw</storageButtonIconTexPath>

        <!-- Work Options -->

        <recreationGainPerTick>0.0001</recreationGainPerTick>
        <workOptions>
            <li>
                <workLabelKey>FCP_Institute_AdvancedSystems_Label</workLabelKey>
                <workDescKey>FCP_Institute_AdvancedSystems_Desc</workDescKey>
                <workButtonIconTexPath>UI/Roles/SpecialistProduction</workButtonIconTexPath>
                <additionalRestFall>0.25</additionalRestFall>
                <experienceGainsPerHour>
                    <Intellectual>400</Intellectual>
                    <Crafting>200</Crafting>
                </experienceGainsPerHour>
            </li>
            <li>
                <workLabelKey>FCP_Institute_SRBTraining_Label</workLabelKey>
                <workDescKey>FCP_Institute_SRBTraining_Desc</workDescKey>
                <workButtonIconTexPath>UI/Roles/SpecialistShooting</workButtonIconTexPath>
                <additionalRestFall>0.3</additionalRestFall>
                <experienceGainsPerHour>
                    <Shooting>500</Shooting>
                    <Melee>100</Melee>
                </experienceGainsPerHour>
            </li>
            <li>
                <workLabelKey>FCP_Institute_Containment_Label</workLabelKey>
                <workDescKey>FCP_Institute_Containment_Desc</workDescKey>
                <workButtonIconTexPath>UI/Icons/ThingCategories/Medicine</workButtonIconTexPath>
                <additionalRestFall>0.25</additionalRestFall>
                <tendCaravanMembersEveryTicks>600</tendCaravanMembersEveryTicks>
                <medicinesToTend>
                    <li>MedicineUltratech</li>
                </medicinesToTend>
                <immunityGainSpeedMultiplier>2.5</immunityGainSpeedMultiplier>
            </li>
        </workOptions>

        <!-- Asset Exchange -->

        <turnInIsEnabled>true</turnInIsEnabled>
        <turnInLabelKey>FCP_Institute_Turn_In_Label</turnInLabelKey>
        <turnInDescKey>FCP_Institute_Turn_In_Desc</turnInDescKey>
        <turnInButtonIconTexPath>UI/Abilities/Stun</turnInButtonIconTexPath>
        <turnInTraderKind>FCP_Caravan_Institute_Asset_Exchange</turnInTraderKind>
        <turnInRefreshSilverInDays>7</turnInRefreshSilverInDays>
        <turnInTraderNameKey>FCP_Institute_Turn_In_Trader_Name</turnInTraderNameKey>

        <!-- Drop Pod Options -->

        <dropPodServiceIsEnabled>false</dropPodServiceIsEnabled>

        <!-- Resign Options -->

        <resignGoodwillGain>-25</resignGoodwillGain>
        <resignMenuTextKey>FCP_Institute_Resign_Menu_Text</resignMenuTextKey>
        <resignLetterTitleKey>FCP_Institute_Resign_Letter_Title</resignLetterTitleKey>
        <resignLetterLabelKey>FCP_Institute_Resign_Letter_Label</resignLetterLabelKey>
        <resignButtonLabelKey>FCP_Institute_Resign_Button_Label</resignButtonLabelKey>
        <resignButtonDescKey>FCP_Institute_Resign_Button_Desc</resignButtonDescKey>
        <resignButtonIconTexPath>UI/Issues/Apostasy</resignButtonIconTexPath>

        <!-- Kicked Out Options -->

        <kickOutLetterTitleKey>FCP_Institute_Kick_Out_Letter_Title</kickOutLetterTitleKey>
        <kickOutLetterLabelKey>FCP_Institute_Kick_Out_Label_Title</kickOutLetterLabelKey>

        <!-- Reinforcements Options -->

        <reinforcementsAreEnabled>true</reinforcementsAreEnabled>
        <reinforcementsButtonLabelKey>FCP_Institute_Reinforcements_Button_Label</reinforcementsButtonLabelKey>
        <reinforcementsButtonDescKey>FCP_Institute_Reinforcements_Button_Desc</reinforcementsButtonDescKey>
        <reinforcementsButtonIconTexPath>UI/Commands/WarTrumpet</reinforcementsButtonIconTexPath>
        <reinforcementCallGoodwillCost>-5</reinforcementCallGoodwillCost>
        <reinforcementCallCooldownTicks>50000</reinforcementCallCooldownTicks>
        <reinforcementOptions>
            <li>
                <relationsRange>75~100</relationsRange>
                <pointsRange>800~1800</pointsRange>
            </li>
            <li>
                <relationsRange>50~74</relationsRange>
                <pointsRange>600~850</pointsRange>
            </li>
            <li>
                <relationsRange>26~49</relationsRange>
                <pointsRange>400~600</pointsRange>
            </li>
            <li>
                <relationsRange>-100~25</relationsRange>
                <pointsRange>100~200</pointsRange>
            </li>
        </reinforcementOptions>

    </FCP.Enlist.FactionEnlistOptionsDef>

</Defs>
