<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!--__________ Institute Research __________-->

    <!-- Institute Holotape Base -->

    <ResearchProjectDef Name="FCP_Institute_Research_Base" Abstract="True">
        <techprintCount>1</techprintCount>
        <techprintCommonality>1</techprintCommonality>
        <heldByFactionCategoryTags>
            <li>FCP_Faction_Institute</li>
        </heldByFactionCategoryTags>
        <tab>FCP_Faction_Research</tab>
        <modExtensions>
            <li Class="FCP.Core.TechprintExtension">
                <baseLabel>FCP_Techprint_Label</baseLabel>
                <baseDescription>FCP_Techprint_Desc</baseDescription>
                <texPath>Things/Items/Techprints/FCP_Techprint_Holotape_Orange</texPath>
                <requiredBenches>
                    <li>FCP_Production_Old_Table_Terminal</li>
                    <li>FCP_Production_Clean_Table_Terminal</li>
                </requiredBenches>
            </li>
        </modExtensions>
    </ResearchProjectDef>

    <!-- Institute Attire -->

    <ResearchProjectDef ParentName="FCP_Institute_Research_Base">
        <defName>FCP_Research_Institute_Attire</defName>
        <label>Institute attire</label>
        <description>Patterns for the lab coats and work jumpsuits worn inside the Institute. The cloth is simple enough. Getting the files out of the Institute is not.</description>
        <baseCost>600</baseCost>
        <techLevel>Industrial</techLevel>
        <prerequisites>
            <li>ComplexClothing</li>
        </prerequisites>
        <researchViewX>0.00</researchViewX>
        <researchViewY>3.50</researchViewY>
    </ResearchProjectDef>

    <!-- Directorate Regalia -->

    <ResearchProjectDef ParentName="FCP_Institute_Research_Base">
        <defName>FCP_Research_Institute_Directorate_Regalia</defName>
        <label>Directorate regalia</label>
        <description>The coats worn by the division heads who sit on the Directorate. The Institute keeps these files on a short list, and handing them over is a sign of real trust.</description>
        <baseCost>1200</baseCost>
        <techLevel>Industrial</techLevel>
        <prerequisites>
            <li>FCP_Research_Institute_Attire</li>
        </prerequisites>
        <researchViewX>1.00</researchViewX>
        <researchViewY>3.50</researchViewY>
    </ResearchProjectDef>

    <!-- Synth Field Armor -->

    <ResearchProjectDef ParentName="FCP_Institute_Research_Base">
        <defName>FCP_Research_Institute_Synth_Field_Armor</defName>
        <label>synth field armor</label>
        <description>Fabrication specs for the uniforms and polymer armor fitted to Institute synths, from the light retrieval kit up to heavy plating. The Institute only issues it to its synths, but it fits anyone.</description>
        <baseCost>1800</baseCost>
        <techLevel>Spacer</techLevel>
        <techprintCount>2</techprintCount>
        <prerequisites>
            <li>FCP_Research_Synth_TierI</li>
        </prerequisites>
        <researchViewX>1.00</researchViewX>
        <researchViewY>4.50</researchViewY>
    </ResearchProjectDef>

    <!-- Courser Uniform -->

    <ResearchProjectDef ParentName="FCP_Institute_Research_Base">
        <defName>FCP_Research_Institute_Courser_Uniform</defName>
        <label>courser uniform</label>
        <description>The armored field coat of the Synth Retention Bureau's Coursers. The SRB guards this design closely, since anyone who can sew one can pass for the people sent to hunt them.</description>
        <baseCost>2500</baseCost>
        <techLevel>Spacer</techLevel>
        <techprintCount>2</techprintCount>
        <prerequisites>
            <li>FCP_Research_Institute_Synth_Field_Armor</li>
        </prerequisites>
        <researchViewX>2.00</researchViewX>
        <researchViewY>4.50</researchViewY>
    </ResearchProjectDef>

</Defs>
