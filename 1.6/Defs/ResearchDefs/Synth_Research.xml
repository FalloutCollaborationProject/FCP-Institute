<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!--__________ Synth Research __________-->

    <!-- Synth Fabrication I -->

    <ResearchProjectDef>
        <defName>FCP_Research_Synth_TierI</defName>
        <label>synth fabrication I</label>
        <description>Basic servo and chassis assembly. Enough to build a synth that moves and works, with no attempt to hide what it is.</description>
        <baseCost>1200</baseCost>
        <techLevel>Industrial</techLevel>
        <prerequisites>
            <li>MicroelectronicsBasics</li>
        </prerequisites>
        <researchViewX>0.00</researchViewX>
        <researchViewY>4.00</researchViewY>
        <tab>FCP_Faction_Research</tab>
    </ResearchProjectDef>

    <!-- Synth Fabrication II -->

    <ResearchProjectDef MayRequire="ludeon.rimworld.biotech">
        <defName>FCP_Research_Synth_TierII</defName>
        <label>synth fabrication II</label>
        <description>Synthetic muscle and tissue grown over a metal frame. Close enough to human to pass a glance, not close enough to pass a scan.</description>
        <baseCost>3200</baseCost>
        <techLevel>Spacer</techLevel>
        <prerequisites>
            <li>FCP_Research_Synth_TierI</li>
            <li>GrowthVats</li>
        </prerequisites>
        <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
        <researchViewX>1.00</researchViewX>
        <researchViewY>4.00</researchViewY>
        <tab>FCP_Faction_Research</tab>
    </ResearchProjectDef>

    <!-- Synth Fabrication III -->

    <ResearchProjectDef MayRequire="ludeon.rimworld.biotech">
        <defName>FCP_Research_Synth_TierIII</defName>
        <label>synth fabrication III</label>
        <description>The third-generation line. Bioengineered down to the blood and the bone, with nothing left to give it away except what's hidden inside.</description>
        <baseCost>8000</baseCost>
        <techLevel>Ultra</techLevel>
        <prerequisites>
            <li>FCP_Research_Synth_TierII</li>
            <li>Archogenetics</li>
        </prerequisites>
        <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
        <requiredResearchFacilities>
            <li>MultiAnalyzer</li>
        </requiredResearchFacilities>
        <researchViewX>2.00</researchViewX>
        <researchViewY>4.00</researchViewY>
        <tab>FCP_Faction_Research</tab>
    </ResearchProjectDef>

    <!-- Molecular Relay -->

    <ResearchProjectDef MayRequire="ludeon.rimworld.biotech">
        <defName>FCP_Research_Institute_MolecularRelay</defName>
        <label>molecular relay</label>
        <description>Matter-stream teleportation, the Institute's signature achievement. Field-tested for years on synths and cargo before anyone in the Directorate agreed to step into the beam themselves.</description>
        <baseCost>10000</baseCost>
        <techLevel>Ultra</techLevel>
        <prerequisites>
            <li>FCP_Research_Synth_TierIII</li>
        </prerequisites>
        <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
        <requiredResearchFacilities>
            <li>MultiAnalyzer</li>
        </requiredResearchFacilities>
        <researchViewX>3.00</researchViewX>
        <researchViewY>4.00</researchViewY>
        <tab>FCP_Faction_Research</tab>
    </ResearchProjectDef>

    <!-- Signal Intercept -->

    <ResearchProjectDef MayRequire="ludeon.rimworld.biotech">
        <defName>FCP_Research_Institute_SignalIntercept</defName>
        <label>signal intercept</label>
        <description>Reverse-engineering the Institute's relay frequency without their cooperation. Slower and cruder than the real thing, and there's no telling what's waiting on the other end when the beam finally locks on.</description>
        <baseCost>16000</baseCost>
        <techLevel>Ultra</techLevel>
        <prerequisites>
            <li>FCP_Research_Synth_TierIII</li>
        </prerequisites>
        <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
        <requiredResearchFacilities>
            <li>MultiAnalyzer</li>
        </requiredResearchFacilities>
        <researchViewX>4.00</researchViewX>
        <researchViewY>4.00</researchViewY>
        <tab>FCP_Faction_Research</tab>
    </ResearchProjectDef>

</Defs>
