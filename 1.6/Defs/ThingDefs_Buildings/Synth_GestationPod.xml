<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!--__________ Synthesizer Pod __________-->

    <ThingDef ParentName="BuildingBase">
        <defName>FCP_Building_SynthesizerPod</defName>
        <label>synthesizer pod</label>
        <description>An Institute gestation pod. Feed it raw materials and it grows a synth to order, ready to walk out once the cycle finishes.</description>
        <thingClass>FCP.Synths.Building_SynthesizerPod</thingClass>
        <drawerType>MapMeshAndRealTime</drawerType>
        <graphicData>
            <texPath>Buildings/Synth_Constructor/FCP_Synth_Constructor_Base</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(3,3)</drawSize>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <castEdgeShadows>true</castEdgeShadows>
        <staticSunShadowHeight>0.5</staticSunShadowHeight>
        <size>(2,3)</size>
        <costList>
            <Steel>200</Steel>
            <ComponentIndustrial>15</ComponentIndustrial>
        </costList>
        <altitudeLayer>Building</altitudeLayer>
        <fillPercent>1.0</fillPercent>
        <useHitPoints>true</useHitPoints>
        <statBases>
            <WorkToBuild>6000</WorkToBuild>
            <MaxHitPoints>300</MaxHitPoints>
            <Flammability>0.5</Flammability>
        </statBases>
        <passability>Impassable</passability>
        <designationCategory>Production</designationCategory>
        <hasInteractionCell>true</hasInteractionCell>
        <interactionCellOffset>(0,0,-1)</interactionCellOffset>
        <tickerType>Normal</tickerType>
        <building>
            <isEdifice>true</isEdifice>
        </building>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>50</basePowerConsumption>
                <shortCircuitInRain>true</shortCircuitInRain>
            </li>
            <li Class="CompProperties_Flickable" />
            <li Class="FCP.Core.CompProperties_TopGraphicOverhang">
                <texPath>Buildings/Synth_Constructor/FCP_Synth_Constructor_Top</texPath>
                <graphicClass>Graphic_Single</graphicClass>
            </li>
        </comps>
        <placeWorkers>
            <li>PlaceWorker_PreventInteractionSpotOverlap</li>
        </placeWorkers>
        <researchPrerequisites>
            <li>FCP_Research_Synth_TierI</li>
        </researchPrerequisites>
    </ThingDef>

</Defs>
