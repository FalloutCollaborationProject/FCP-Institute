        </modExtensions>
    </RecipeDef>

    <!--_____ Staff Clothing _____-->

    <!-- Institute Lab Coat -->

    <RecipeDef ParentName="FCP_Institute_Tailoring_Recipe_Base">
        <defName>FCP_Recipe_Make_Institute_Lab_Coat</defName>
        <label>make Institute lab coat</label>
        <description>Sew an Institute lab coat from patterns supplied by the Institute. Requires strong relations with the Institute.</description>
        <jobString>Making Institute lab coat.</jobString>
        <workAmount>6000</workAmount>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>Cloth</li>
                    </thingDefs>
                </filter>
                <count>45</count>
            </li>
        </ingredients>
        <products>
            <FCP_Apparel_Institute_Lab_Coat>1</FCP_Apparel_Institute_Lab_Coat>
        </products>
        <skillRequirements>
            <Crafting>4</Crafting>
        </skillRequirements>
        <researchPrerequisite>FCP_Research_Institute_Attire</researchPrerequisite>
    </RecipeDef>

