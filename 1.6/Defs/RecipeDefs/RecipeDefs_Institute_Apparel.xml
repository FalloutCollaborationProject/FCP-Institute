<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!--__________ Institute Apparel Recipes __________-->

    <!-- Institute Tailoring Recipe Base -->

    <RecipeDef Name="FCP_Institute_Tailoring_Recipe_Base" Abstract="True">
        <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
        <workSkill>Crafting</workSkill>
        <effectWorking>Tailor</effectWorking>
        <soundWorking>Recipe_Tailor</soundWorking>
        <unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
        <recipeUsers>
            <li>FCP_Production_Tailoring_Workbench</li>
        </recipeUsers>
        <modExtensions>
            <li Class="FCP.Factions.RecipeExtension_FactionGoodwillCheck">
                <requireFaction>FCP_Faction_Institute</requireFaction>
                <minimumGoodwill>70</minimumGoodwill>
                <uncraftableIfFactionDefeated>true</uncraftableIfFactionDefeated>
            </li>
        </modExtensions>
    </RecipeDef>

    <!-- Institute Armor Recipe Base -->

    <RecipeDef Name="FCP_Institute_Armor_Recipe_Base" Abstract="True">
        <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
