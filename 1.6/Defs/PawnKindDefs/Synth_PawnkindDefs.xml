<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!--__________ Synth Pawnkind Base __________-->

    <PawnKindDef Name="FCP_SynthkindBase" Abstract="True">
        <race>Human</race>
        <defaultFactionDef MayRequire="Rick.FCP.Institute">FCP_Faction_Institute</defaultFactionDef>
        <chemicalAddictionChance>0</chemicalAddictionChance>
        <apparelIgnoreSeasons>true</apparelIgnoreSeasons>
        <apparelMoney>0</apparelMoney>
        <weaponMoney>0</weaponMoney>
        <initialWillRange>1~3</initialWillRange>
        <initialResistanceRange>10~20</initialResistanceRange>
        <disallowedTraits>
            <li>Nudist</li>
        </disallowedTraits>
    </PawnKindDef>

    <!--__________ Gen I __________-->

    <PawnKindDef ParentName="FCP_SynthkindBase">
        <defName>FCP_Pawnkind_Synth_GenI</defName>
        <label>gen 1 synth</label>
        <combatPower>40</combatPower>
        <itemQuality>Poor</itemQuality>
        <gearHealthRange>1~1.8</gearHealthRange>
        <xenotypeSet>
            <xenotypeChances>
                <FCP_Xenotype_Synth_GenI>1</FCP_Xenotype_Synth_GenI>
            </xenotypeChances>
        </xenotypeSet>
        <useFactionXenotypes>false</useFactionXenotypes>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>FCP_Backstory_Synth</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>FCP_Backstory_Synth_GenI</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
    </PawnKindDef>

    <!--__________ Gen II __________-->

    <PawnKindDef ParentName="FCP_SynthkindBase">
        <defName>FCP_Pawnkind_Synth_GenII</defName>
        <label>gen 2 synth</label>
        <combatPower>45</combatPower>
        <itemQuality>Normal</itemQuality>
        <gearHealthRange>1~1.8</gearHealthRange>
        <apparelTags>
            <li>FCP_Institute_Synth_Apparel</li>
        </apparelTags>
        <apparelRequired>
            <li>FCP_Apparel_Synth_Uniform</li>
        </apparelRequired>
        <xenotypeSet>
            <xenotypeChances>
                <FCP_Xenotype_Synth_GenII>1</FCP_Xenotype_Synth_GenII>
            </xenotypeChances>
        </xenotypeSet>
        <useFactionXenotypes>false</useFactionXenotypes>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>FCP_Backstory_Synth</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>FCP_Backstory_Synth_GenII</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
    </PawnKindDef>

    <!--__________ Gen III __________-->

    <PawnKindDef ParentName="FCP_SynthkindBase">
        <defName>FCP_Pawnkind_Synth_GenIII</defName>
        <label>gen 3 synth</label>
        <combatPower>45</combatPower>
        <itemQuality>Normal</itemQuality>
        <gearHealthRange>1~1.8</gearHealthRange>
        <xenotypeSet>
            <xenotypeChances>
                <Baseliner>1</Baseliner>
            </xenotypeChances>
        </xenotypeSet>
        <useFactionXenotypes>false</useFactionXenotypes>
        <startingHediffs>
            <li>
                <def>FCP_Hediff_SynthComponents_GenIII</def>
            </li>
        </startingHediffs>
    </PawnKindDef>

</Defs>
