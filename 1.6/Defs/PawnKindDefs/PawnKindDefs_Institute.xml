<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!--__________ Institute Pawnkinds __________-->

    <!--___ Base Definitions ___-->

    <PawnKindDef Name="FCP_InstituteKindBase" Abstract="true">
        <race>Human</race>
        <defaultFactionType>FCP_Faction_Institute</defaultFactionType>
        <chemicalAddictionChance>0</chemicalAddictionChance>
        <backstoryCryptosleepCommonality>0</backstoryCryptosleepCommonality>
        <itemQuality>Good</itemQuality>
        <gearHealthRange>0.9~1.0</gearHealthRange>
        <apparelIgnoreSeasons>true</apparelIgnoreSeasons>
        <combatPower>90</combatPower>
        <minGenerationAge>25</minGenerationAge>
        <maxGenerationAge>55</maxGenerationAge>
        <apparelMoney>500~800</apparelMoney>
        <apparelTags>
            <li>FCP_Institute_Apparel</li>
        </apparelTags>
        <apparelAllowHeadgearChance>0</apparelAllowHeadgearChance>
        <weaponMoney>500~900</weaponMoney>
        <weaponTags>
            <li>SpacerGun</li>
            <li MayRequire="Rick.FCP.EnergyWeapons">FCP_Laser_Weapon</li>
        </weaponTags>
        <initialWillRange>1~3</initialWillRange>
        <initialResistanceRange>15~25</initialResistanceRange>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>FCP_Backstory_Institute_Child</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>FCP_Backstory_Institute</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
        <forcedTraits>
            <FCP_Trait_Institute_Loyalist>0</FCP_Trait_Institute_Loyalist>
        </forcedTraits>
    </PawnKindDef>

    <!-- Institute Combat Synth Base -->

    <PawnKindDef Name="FCP_InstituteCombatSynthBase" ParentName="FCP_InstituteKindBase" Abstract="true">
        <useFactionXenotypes>false</useFactionXenotypes>
        <apparelMoney>0</apparelMoney>
        <apparelTags Inherit="False">
            <li>FCP_Institute_Synth_Apparel</li>
        </apparelTags>
        <requiredWorkTags>
            <li>Violent</li>
        </requiredWorkTags>
        <disallowedTraits>
            <li>Nudist</li>
        </disallowedTraits>
    </PawnKindDef>

    <!-- Gen I Combat Synth Base -->

    <PawnKindDef Name="FCP_InstituteSynthGenIBase" ParentName="FCP_InstituteCombatSynthBase" Abstract="true">
        <itemQuality>Normal</itemQuality>
        <weaponMoney>800~1000</weaponMoney>
        <xenotypeSet>
            <xenotypeChances>
                <FCP_Xenotype_Synth_GenI>1</FCP_Xenotype_Synth_GenI>
            </xenotypeChances>
        </xenotypeSet>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>FCP_Backstory_Synth</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>FCP_Backstory_Synth_GenI</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
    </PawnKindDef>

    <!-- Light Gen I Synth -->

    <PawnKindDef ParentName="FCP_InstituteSynthGenIBase">
        <defName>FCP_Pawnkind_Institute_Synth_GenI_Light</defName>
        <label>light gen 1 synth</label>
        <combatPower>70</combatPower>
        <apparelRequired>
            <li>FCP_Apparel_Synth_Armor_Light</li>
            <li>FCP_Apparel_Synth_Helmet_Light</li>
        </apparelRequired>
    </PawnKindDef>

    <!-- Sturdy Gen I Synth -->

    <PawnKindDef ParentName="FCP_InstituteSynthGenIBase">
        <defName>FCP_Pawnkind_Institute_Synth_GenI_Sturdy</defName>
        <label>sturdy gen 1 synth</label>
        <combatPower>85</combatPower>
        <apparelRequired>
            <li>FCP_Apparel_Synth_Armor_Sturdy</li>
            <li>FCP_Apparel_Synth_Helmet_Sturdy</li>
        </apparelRequired>
    </PawnKindDef>

    <!-- Heavy Gen I Synth -->

    <PawnKindDef ParentName="FCP_InstituteSynthGenIBase">
        <defName>FCP_Pawnkind_Institute_Synth_GenI_Heavy</defName>
        <label>heavy gen 1 synth</label>
        <combatPower>100</combatPower>
        <apparelRequired>
            <li>FCP_Apparel_Synth_Armor_Heavy</li>
            <li>FCP_Apparel_Synth_Helmet_Heavy</li>
        </apparelRequired>
    </PawnKindDef>

    <!-- Gen II Combat Synth Base -->

    <PawnKindDef Name="FCP_InstituteSynthGenIIBase" ParentName="FCP_InstituteCombatSynthBase" Abstract="true">
        <weaponMoney>800~1200</weaponMoney>
        <xenotypeSet>
            <xenotypeChances>
                <FCP_Xenotype_Synth_GenII>1</FCP_Xenotype_Synth_GenII>
            </xenotypeChances>
        </xenotypeSet>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>FCP_Backstory_Synth</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>FCP_Backstory_Synth_GenII</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
    </PawnKindDef>

    <!-- Light Gen II Synth -->

    <PawnKindDef ParentName="FCP_InstituteSynthGenIIBase">
        <defName>FCP_Pawnkind_Institute_Synth_GenII_Light</defName>
        <label>light gen 2 synth</label>
        <combatPower>100</combatPower>
        <apparelRequired>
            <li>FCP_Apparel_Synth_Uniform</li>
            <li>FCP_Apparel_Synth_Armor_Light</li>
            <li>FCP_Apparel_Synth_Helmet_Light</li>
        </apparelRequired>
    </PawnKindDef>

    <!-- Sturdy Gen II Synth -->

    <PawnKindDef ParentName="FCP_InstituteSynthGenIIBase">
        <defName>FCP_Pawnkind_Institute_Synth_GenII_Sturdy</defName>
        <label>sturdy gen 2 synth</label>
        <combatPower>120</combatPower>
        <apparelRequired>
            <li>FCP_Apparel_Synth_Uniform</li>
            <li>FCP_Apparel_Synth_Armor_Sturdy</li>
            <li>FCP_Apparel_Synth_Helmet_Sturdy</li>
        </apparelRequired>
    </PawnKindDef>

    <!-- Heavy Gen II Synth -->

    <PawnKindDef ParentName="FCP_InstituteSynthGenIIBase">
        <defName>FCP_Pawnkind_Institute_Synth_GenII_Heavy</defName>
        <label>heavy gen 2 synth</label>
        <combatPower>140</combatPower>
        <apparelRequired>
            <li>FCP_Apparel_Synth_Uniform</li>
            <li>FCP_Apparel_Synth_Armor_Heavy</li>
            <li>FCP_Apparel_Synth_Helmet_Heavy</li>
        </apparelRequired>
    </PawnKindDef>

    <!-- Courser -->

    <PawnKindDef ParentName="FCP_InstituteCombatSynthBase">
        <defName>FCP_Pawnkind_Institute_Courser</defName>
        <label>courser</label>
        <combatPower>170</combatPower>
        <itemQuality>Excellent</itemQuality>
        <apparelTags Inherit="False">
            <li>FCP_Institute_Courser_Apparel</li>
        </apparelTags>
        <apparelRequired>
            <li>FCP_Apparel_Institute_Courser_Uniform</li>
        </apparelRequired>
        <weaponMoney>1400~2000</weaponMoney>
        <xenotypeSet>
            <xenotypeChances>
                <Baseliner>1</Baseliner>
            </xenotypeChances>
        </xenotypeSet>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>FCP_Backstory_Synth</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>FCP_Backstory_Synth_Courser</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
        <startingHediffs>
            <li>
                <def>FCP_Hediff_SynthComponents_GenIII</def>
            </li>
        </startingHediffs>
    </PawnKindDef>

    <!-- Institute Personnel -->

    <PawnKindDef ParentName="FCP_InstituteKindBase">
        <defName>FCP_Pawnkind_Institute_Personnel</defName>
        <label>Institute personnel</label>
        <combatPower>40</combatPower>
        <apparelMoney>300~600</apparelMoney>
        <weaponMoney>0~0</weaponMoney>
    </PawnKindDef>

    <!-- Synth Requisition Officer -->

    <PawnKindDef ParentName="FCP_InstituteKindBase">
        <defName>FCP_Pawnkind_Institute_RequisitionOfficer</defName>
        <label>synth requisition officer</label>
        <combatPower>40</combatPower>
        <apparelMoney>0</apparelMoney>
        <apparelTags Inherit="False">
            <li>FCP_Institute_Synth_Apparel</li>
        </apparelTags>
        <apparelRequired>
            <li>FCP_Apparel_Synth_Uniform</li>
        </apparelRequired>
        <weaponMoney>0~0</weaponMoney>
        <trader>true</trader>
        <useFactionXenotypes>false</useFactionXenotypes>
        <xenotypeSet>
            <xenotypeChances>
                <FCP_Xenotype_Synth_GenII>1</FCP_Xenotype_Synth_GenII>
            </xenotypeChances>
        </xenotypeSet>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>FCP_Backstory_Synth</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>FCP_Backstory_Synth_GenII</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
    </PawnKindDef>

</Defs>
