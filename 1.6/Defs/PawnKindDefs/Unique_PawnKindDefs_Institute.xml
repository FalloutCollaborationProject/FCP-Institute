<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!--__________ Institute Unique Pawnkinds __________-->

    <!-- Father (Shaun) -->

    <PawnKindDef ParentName="FCP_InstituteKindBase">
        <defName>FCP_Unique_Pawnkind_Father</defName>
        <label>Father</label>
        <factionLeader>true</factionLeader>
        <combatPower>60</combatPower>
        <maxGenerationAge>60</maxGenerationAge>
        <minGenerationAge>60</minGenerationAge>
        <apparelMoney>900~1300</apparelMoney>
        <weaponMoney>200~400</weaponMoney>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>FCP_Character_Backstory_Father_Child</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>FCP_Character_Backstory_Father_Adult</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
    </PawnKindDef>

