    <!-- DiMA -->

    <FCP.Core.CharacterDef>
        <defName>FCP_Character_Synth_DiMA</defName>
        <pawnKind>FCP_Unique_Pawnkind_DiMA</pawnKind>
        <xenotype>FCP_Xenotype_Synth_GenII</xenotype>
        <definitions>
            <li Class="FCP.Core.CharacterStoryDefinition">
                <firstName>DiMA</firstName>
                <nickname>DiMA</nickname>
                <gender>Male</gender>
                <age>40</age>
            </li>
            <li Class="FCP.Core.CharacterAppearanceDefinition">
                <headTypeDef>FCP_Male_Synth_GenII_Head_DiMA</headTypeDef>
                <bodyTypeDef>Male</bodyTypeDef>
                <hairDef>Bald</hairDef>
                <skinColorOverride>(255, 255, 255)</skinColorOverride>
            </li>
            <li Class="FCP.Core.CharacterHediffDefinition">
                <hediffDef>FCP_Hediff_Synth_DiMA_Frame</hediffDef>
            </li>
        </definitions>
    </FCP.Core.CharacterDef>

