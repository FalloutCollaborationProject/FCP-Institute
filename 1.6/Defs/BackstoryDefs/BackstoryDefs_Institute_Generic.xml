        <defName>FCP_Backstory_Institute_Child_General</defName>
        <identifier>FCP_Backstory_Institute_Child_General</identifier>
        <title>Institute Youth</title>
        <titleShort>Institute Youth</titleShort>
        <baseDesc>[PAWN_nameDef] grew up underground on a schedule set by testing and evaluation rather than birthdays. [PAWN_pronoun] was told the surface was a mistake still being cleaned up, and had no particular reason to doubt it.</baseDesc>
